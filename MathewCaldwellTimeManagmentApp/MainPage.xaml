<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MathewCaldwellTimeManagmentApp.MainPage">

    <ScrollView>
        <VerticalStackLayout>
            <HorizontalStackLayout>
                <CollectionView x:Name="taskListView" SelectionMode="Single" SelectionChanged="taskListView_SelectionChanged" ItemsSource="{Binding timeList}"/>
                <Button BackgroundColor="DarkOliveGreen" Text="Start" x:Name="startTimerBtn" Clicked="TimerStartStop_Clicked" HeightRequest="30" Margin="15"/>
                <Label x:Name="timerLabel" Text="00:00" VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout>
                <Entry Placeholder="Enter Task Name" x:Name="taskEntry"/>
                <Button Text="Add" x:Name="taskEntryBtn"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
