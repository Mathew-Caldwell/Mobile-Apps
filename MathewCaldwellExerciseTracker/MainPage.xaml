<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MathewCaldwellExerciseTracker.MainPage">

    <ScrollView>
        <VerticalStackLayout>
            <Button Text="Settings" Clicked="Setting_Clicked"/>
            <Label Text="X minutes today"/>
            <Entry Placeholder="log number of minutes" x:Name="logEntry"/>
            <Button Text="log" Clicked="Log_Clicked"/>
            <Label Text="Need to do X min of exercise per day"/>
            <Label Text="Total exercise time: XX:XX Required exercise time: YY:YY"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
