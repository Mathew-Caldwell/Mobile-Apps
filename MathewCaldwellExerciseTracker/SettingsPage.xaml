<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MathewCaldwellExerciseTracker.SettingsPage"
             BackgroundColor="White"
             Title="SettingsPage">
    
    <ScrollView>
        <VerticalStackLayout>
            <Button Text="back" Clicked="Back_Clicked" x:Name="BackButton"/>
            <HorizontalStackLayout>
                <Slider Minimum="5" Maximum="60" ValueChanged="Slider_ValueChanged" x:Name="changeMinPerDay" WidthRequest="500"/>
                <Label Text="30" x:Name="numberOfMinutesPerDayLabel"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout>
                <Button BackgroundColor="White" x:Name="WhiteButton" Clicked="BackgroundColourChange_Clicked"/>
                <Button BackgroundColor="Black" x:Name="WhiteButton" Clicked="BackgroundColourChange_Clicked"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout>
                <Button BackgroundColor="Red" x:Name="WhiteButton" Clicked="BackgroundColourChange_Clicked"/>
                <Button BackgroundColor="Purple" x:Name="WhiteButton" Clicked="BackgroundColourChange_Clicked"/>
            </HorizontalStackLayout>
            <Button Text="Reset Data" BackgroundColor="Red" TextColor="Black" Clicked="RestedData_Clicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>