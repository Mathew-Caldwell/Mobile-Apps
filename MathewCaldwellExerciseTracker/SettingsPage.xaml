<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MathewCaldwellExerciseTracker.SettingsPage"
             Title="SettingsPage">
    
    <ScrollView>
        <VerticalStackLayout>
            <Button Text="back" Clicked="Back_Clicked"/>
            <HorizontalStackLayout>
                <Slider Minimum="5" Maximum="60" ValueChanged="Slider_ValueChanged" x:Name="changeMinPerDay" WidthRequest="500"/>
                <Label Text="30" x:Name="numberOfMinutesPerDayLabel"/>
            </HorizontalStackLayout>
            <Button Text="Reset Data" BackgroundColor="Red" TextColor="Black" Clicked="RestedData_Clicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>