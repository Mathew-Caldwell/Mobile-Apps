<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Mathew_Caldwell_Media_Tracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Mathew_Caldwell_Media_Tracker"
    Title="Mathew_Caldwell_Media_Tracker">

    <TabBar>
        <Tab Title="Everything">
            <ShellContent ContentTemplate="{DataTemplate local:EverythingTab}"
            Route="MainPage" />
        </Tab>
        <Tab Title="Released">
            <ShellContent ContentTemplate="{DataTemplate local:ReleasedTab}"/>
        </Tab>
        <Tab Title="Upcoming">
            <ShellContent ContentTemplate="{DataTemplate local:UpcomingTab}"/>
        </Tab>
        <Tab Title="Finished">
            <ShellContent ContentTemplate="{DataTemplate local:FinishedTab}"/>
        </Tab>
    </TabBar>

</Shell>
